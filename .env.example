APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------
# DATABASE CONFIGURATION
# -----------------------------
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=


# -----------------------------
# SESSION & CACHE
# -----------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# -----------------------------
# MAIL SETTINGS
# -----------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# -----------------------------
# AWS (Optional)
# -----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------
# FRONTEND (Vite / React)
# -----------------------------
VITE_APP_NAME="${APP_NAME}"

# -----------------------------
# GOOGLE AUTH SETTINGS
# -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------
# GOOGLE AI SETTINGS
# -----------------------------
GOOGLE_AI_API_KEY=

SLACK_BOT_TOKEN=
SLACK_CHANNEL=



QUEUE_CONNECTION=database

API_PREFIX=api


